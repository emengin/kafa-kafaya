{
  "name": "kafa-kafaya",
  "private": true,
  "version": "1.0.0",
  "description": "Kafa Kafaya — tarayıcıda oynanan 2D, 1v1 kafa topu oyunu.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync android",
    "build:mobile:dev": "tsc --noEmit && vite build --mode mobile-dev",
    "cap:sync:dev": "npm run build:mobile:dev && cap sync android",
    "cap:open": "cap open android",
    "assets:placeholder": "node scripts/run-ts.js scripts/mobile/placeholderAssets.ts",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "screens": "playwright test -c playwright.screens.config.ts",
    "simulate": "node scripts/run-ts.js scripts/simulate.ts",
    "bench": "node scripts/run-ts.js scripts/bench/bench.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
